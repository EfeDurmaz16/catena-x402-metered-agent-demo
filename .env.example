# Catena account the CLI pays from (accounts list shows ids).
CATENA_ACCOUNT_ID=

# Catena CLI credential profile (catena profiles list). Needed when more than
# one profile exists on the machine. Consumed by the catena CLI subprocess,
# not by this repo's code.
CATENA_PROFILE=

# Total the runner may spend across all calls in one run ("$x.yz").
SPEND_CAP_USD=$0.05

# Per-call ceiling passed to the CLI as --maxAmount (defense in depth).
PER_CALL_MAX_USD=$0.025

# Advanced (defaults are correct for the sandbox demo):
#   X402_NETWORK  only challenges on this network are paid (eip155:84532)
#   X402_ASSET    only this token is paid (Base Sepolia USDC)
#   CATENA_BIN    path to the catena binary; tests point it at a stub

# Paid endpoint. Defaults target BlockRun's Base Sepolia testnet image API
# (openai/gpt-image-1, ~$0.021 per image, pay-on-delivery). For the chat
# flow, uncomment the three lines below.
#ENDPOINT_KIND=chat
#ENDPOINT_URL=https://testnet.blockrun.ai/api/v1/chat/completions
#MODEL=openai/gpt-oss-20b
